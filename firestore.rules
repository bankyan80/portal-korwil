rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    function isOperator() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator_sekolah';
    }
    
    function getOperatorSchoolId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId;
    }

    function ownsSchool(data) {
      return data.schoolId == getOperatorSchoolId() ||
             data.sekolahId == getOperatorSchoolId() ||
             data.sekolah_id == getOperatorSchoolId();
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Super admin can read all users
      allow read: if isSuperAdmin();
      // Only super admin can create/update/delete users
      allow write: if isSuperAdmin();
    }
    
    // Employees collection
    match /employees/{employeeId} {
      // Public can read (for dashboards)
      allow read: if true;
      // Operators can only manage their own school's employees
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Students collection
    match /students/{studentId} {
      // Public can read (for dashboards)
      allow read: if true;
      // Operators can only manage their own school's students
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Schools collection
    match /schools/{schoolId} {
      // Public can read
      allow read: if true;
      // Super admin can write all; operators can update their own school profile.
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isOperator() && schoolId == getOperatorSchoolId());
    }
    
    // Monthly reports (laporan_bulanan)
    match /laporan_bulanan/{reportId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's reports
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // News (berita)
    match /berita/{beritaId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's news
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }

    // News collection used by admin UI
    match /news/{newsId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Gallery
    match /galeri/{galeriId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's gallery
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }

    // Gallery collection used by admin UI
    match /gallery/{galleryId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Documents
    match /dokumen/{dokumenId} {
      // Documents are not public-listable; public lookup goes through /api/dokumen/list.
      allow read: if isSuperAdmin() || 
                  (isOperator() && ownsSchool(resource.data));
      // Operators can only manage their own school's documents
      allow create: if isSuperAdmin() ||
                    (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() ||
                    (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() ||
                    (isOperator() && ownsSchool(resource.data));
    }
    
    // SPMB (student registration)
    match /spmb/{spmbId} {
      // Operators and super admin can read
      allow read: if isSuperAdmin() || isOperator();
      // Operators can only manage their own school's registrations
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Sarpras (facilities)
    match /sarpras/{sarprasId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's facilities
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Settings
    match /settings/{settingId} {
      // Public can read
      allow read: if true;
      // Only super admin can write
      allow write: if isSuperAdmin();
    }
    
    // KIP SD
    match /kip_sd/{kipId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's KIP data
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Yatim Piatu
    match /yatim_piatu/{yatimId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's data
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // BOS Arkas
    match /bos_arkas/{bosId} {
      // Public can read
      allow read: if true;
      // Operators can only manage their own school's data
      allow create: if isSuperAdmin() || (isOperator() && ownsSchool(request.resource.data));
      allow update: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data) && ownsSchool(request.resource.data));
      allow delete: if isSuperAdmin() || (isOperator() && ownsSchool(resource.data));
    }
    
    // Tabel Sekolah
    match /tabel_sekolah/{tabelId} {
      // Public can read
      allow read: if true;
      // Only super admin can write
      allow write: if isSuperAdmin();
    }
  }
}

# Firebase Service Account (JSON string or base64 encoded)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Drive Configuration
# Root folder ID in Google Drive where all files will be stored
# Default: Portal Korwil shared folder
GOOGLE_DRIVE_FOLDER_ROOT_ID=1ROF4T8UETEfCyY_pzkwRh7c5rK7hdYSJ

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Google Search Grounding (Custom Search JSON API)
# Get API key from https://console.cloud.google.com/apis/credentials
# Get Search Engine ID (cx) from https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

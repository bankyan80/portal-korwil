# Firebase Service Account (JSON string or base64 encoded)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternative if Vercel has trouble with full JSON:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Drive Configuration
# Root folder ID in Google Drive where all files will be stored
# Default: Portal Korwil shared folder
GOOGLE_DRIVE_FOLDER_ROOT_ID=1ROF4T8UETEfCyY_pzkwRh7c5rK7hdYSJ

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Sheet ID (main spreadsheet)
GOOGLE_SHEET_ID=1v4jy1VNM9xNCLMa_B3xr-jOlayBNBDILptN_nxKT2sc

# GTK Summary: override published sheet URLs (JSON array of {url, sekolah})
# GTK_SHEET_URLS=[{"url":"...","sekolah":"SD NEGERI 1 ASEM"}]

# Set to "false" to disable mock/fallback data when Firebase is unavailable
NEXT_PUBLIC_USE_MOCK_DATA=true

# Gemini AI Configuration
# Google Search Grounding is built-in via tools: [{ googleSearch: {} }] — no extra API keys needed
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
